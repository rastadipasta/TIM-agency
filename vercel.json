{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-gFWcpBjhWUqHrAnKyNGP/ZOmjIc2q9XHGuYibXm5/bE=' 'sha256-3S02KRFer+Xd6YvyTjdytBjxfFEW2tJpqR33dS3Gi0A=' 'sha256-QW9I9dP4bwSmeUSEqXE1tnvCCr6DB6zEOFPh6k31Yzw='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; media-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; worker-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/build-production.mjs",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/usluga-web-dizajn.html",
      "destination": "/#services/web-design",
      "permanent": true
    },
    {
      "source": "/en/web-design.html",
      "destination": "/#services/web-design",
      "permanent": true
    },
    {
      "source": "/usluga-graficki-dizajn.html",
      "destination": "/#services/graphic-design",
      "permanent": true
    },
    {
      "source": "/en/graphic-design.html",
      "destination": "/#services/graphic-design",
      "permanent": true
    },
    {
      "source": "/usluga-digitalni-proizvodi.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/en/digital-products.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/galerija.html",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/en/portfolio.html",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/kontakt.html",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/en/contact.html",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/en/brief.html",
      "destination": "/brief.html",
      "permanent": true
    },
    {
      "source": "/privatnost.html",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/en/privacy.html",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/uvjeti-koristenja.html",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/en/terms.html",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/kolacici.html",
      "destination": "/cookies.html",
      "permanent": true
    },
    {
      "source": "/en/cookies.html",
      "destination": "/cookies.html",
      "permanent": true
    }
  ]
}
